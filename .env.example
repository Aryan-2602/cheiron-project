# OpenAI API key — used only for query understanding (intent + entity extraction).
# OPENAI_API_KEY is also accepted as an alias.
OPEN_AI_API_KEY=

# Model for the query-understanding call. gpt-4.1-mini is a faster, cheaper
# alternative; both were verified working with structured outputs.
LLM_MODEL=gpt-5.4-mini

ENV=development
LOG_LEVEL=INFO
