# OpenAI API key — used only for query understanding (intent + entity extraction).
# OPENAI_API_KEY is also accepted as an alias.
OPEN_AI_API_KEY=

# Model for the query-understanding call. gpt-4.1-mini is a faster, cheaper
# alternative; both were verified working with structured outputs.
LLM_MODEL=gpt-5.4-mini

ENV=development
LOG_LEVEL=INFO

# RxNorm drug synonym resolution for network graphs (NLM, no API key needed).
# Set RXNORM_ENABLED=false to fall back to string-only name normalization.
RXNORM_ENABLED=true
RXNORM_MIN_SCORE=11.0
RXNORM_CANDIDATE_POOL=120

# --- ClinicalTrials.gov client (defaults shown; all optional) ---
# CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
# CTGOV_PAGE_SIZE=1000          # API maximum; omitting pageSize yields only 10.
# CTGOV_TIMEOUT_SECONDS=30.0
# CTGOV_MAX_RETRIES=3

# --- RxNorm client (defaults shown; all optional) ---
# RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
# RXNORM_TIMEOUT_SECONDS=10.0
# RXNORM_MAX_RETRIES=2
# RXNORM_MAX_CONCURRENCY=5
